# .env.example

# Gateway URL for frontend
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Dev token with role="trader"
# Generated using: 
# node -e "const j=require('jsonwebtoken'); console.log(j.sign({sub:'trader123',role:'trader',iss:'robin-gateway',aud:'robin-services'}, 'new-secure-dev-secret', {expiresIn: '15m'}));"
NEXT_PUBLIC_GATEWAY_API_TOKEN=your_jwt_token_here

# Backend Secret (must match the secret used to sign NEXT_PUBLIC_GATEWAY_API_TOKEN)
ROBIN_GATEWAY_API_TOKEN=new-secure-dev-secret
